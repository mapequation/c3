{
  "compilerOptions": {
    "allowJs": false,
    "noImplicitAny": true,
    "target": "ES6",
    "lib": ["ES2017"],
    "module": "ES6",
    "esModuleInterop": true,
    "declaration": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "rootDir": "src",
    "outDir": "lib"
  },
  "include": ["src/**/*"],
  "exclude": ["src/**/*.test.ts"]
}
